# Cloudflare Pages: cabeceras de caché
# El service worker y el manifiesto nunca se cachean, así la PWA se actualiza sola.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Archivos con hash: caché largo
/assets/*
  Cache-Control: public, max-age=31536000, immutable
