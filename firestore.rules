rules_version = '2';

// Reglas de seguridad de GloryChef (varios restaurantes)
// Datos de cada restaurante: restaurants/{rid}/{colección}/{doc}
// Personal: users/{uid} con role y restaurantId.
// - El público (menú del cliente) solo lee el catálogo, crea pedidos y se registra a eventos.
// - El personal solo opera en su propio restaurante.
// - Solo el administrador de un restaurante gestiona a su personal.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isStaffUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role in ['admin', 'cashier', 'cook']
        && me().get('disabled', false) != true;
    }
    // Usuarios creados antes de la versión multi-restaurante pertenecen al demo
    function myRestaurant() {
      return me().get('restaurantId', 'glorychef');
    }
    function isStaffOf(rid) {
      return isStaffUser() && myRestaurant() == rid;
    }
    function isAdminOf(rid) {
      return (isStaffOf(rid) && me().role == 'admin') || isSuperAdmin();
    }
    // Dueño de GloryChef: crea y controla los restaurantes clientes
    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role == 'superadmin';
    }

    match /restaurants/{rid} {
      // Ficha del restaurante (nombre, plan, estado)
      allow read: if true;
      // Solo el dueño de GloryChef crea restaurantes o cambia plan, estado y vencimiento
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isAdminOf(rid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'active', 'trialEndsAt', 'slug']));

      match /config/{docId} {
        allow read: if true;
        allow write: if isStaffOf(rid) || isSuperAdmin();
      }

      match /products/{id} {
        allow read: if true;
        allow create, delete: if isStaffOf(rid);
        // El cliente solo puede descontar stock al hacer un pedido
        allow update: if isStaffOf(rid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
              && request.resource.data.stock < resource.data.stock);
      }

      match /categories/{id} {
        allow read: if true;
        allow write: if isStaffOf(rid);
      }
      match /tables/{id} {
        allow read: if true;
        allow write: if isStaffOf(rid);
      }
      match /zones/{id} {
        allow read: if true;
        allow write: if isStaffOf(rid);
      }
      match /events/{id} {
        allow read: if true;
        allow write: if isStaffOf(rid);
      }

      match /event_registrations/{id} {
        allow create: if true;
        allow read, update, delete: if isStaffOf(rid);
      }

      match /orders/{id} {
        // Seguimiento por enlace y búsqueda por teléfono/número (máx. 5 resultados)
        allow get: if true;
        allow list: if isStaffOf(rid) || request.query.limit <= 5;
        // Pedido del cliente: siempre entra como pendiente de aprobación
        allow create: if isStaffOf(rid)
          || (request.resource.data.status == 'pending_approval'
              && request.resource.data.createdBy == 'client'
              && request.resource.data.total is number
              && request.resource.data.total >= 0);
        allow update, delete: if isStaffOf(rid);
      }

      match /shifts/{id} {
        allow read, write: if isStaffOf(rid);
      }
      match /expenses/{id} {
        allow read, write: if isStaffOf(rid);
      }
      match /logs/{id} {
        allow read, create: if isStaffOf(rid);
      }
    }

    // Personal
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdminOf(resource.data.get('restaurantId', 'glorychef')));
      allow list: if signedIn() && (isSuperAdmin() || isAdminOf(resource.data.restaurantId));
      // Crear/editar personal solo dentro del propio restaurante
      allow create: if isSuperAdmin()
        || (isAdminOf(request.resource.data.restaurantId) && request.resource.data.role != 'superadmin');
      allow update: if isSuperAdmin()
        || (isAdminOf(resource.data.get('restaurantId', 'glorychef'))
            && request.resource.data.get('restaurantId', 'glorychef') == myRestaurant()
            && request.resource.data.role != 'superadmin');
      allow delete: if isAdminOf(resource.data.get('restaurantId', 'glorychef'));
    }

    // Datos del formato anterior (un solo restaurante): solo lectura del admin para migrarlos
    match /{legacy}/{id} {
      allow read: if legacy in ['orders', 'products', 'categories', 'tables', 'shifts',
                                'expenses', 'logs', 'events', 'event_registrations', 'config']
        && isStaffUser() && me().role == 'admin';
    }
  }
}
