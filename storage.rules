rules_version = '2';

// Fotos de GloryChef: lectura pública, subida solo para personal logueado (imágenes < 5 MB)
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
